# --- Infra (docker compose) ---
PROJECT_NAME=feca
APP_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Set by CI on deploy (do not edit manually unless rolling back)
# FECA_IMAGE=ghcr.io/your-org/feca-backend:abc123

POSTGRES_DB=feca_backend
POSTGRES_USER=feca
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=30
DISK_MAX_PERCENT=85

# --- App (passed to backend container) ---
NODE_ENV=production
PORT=3001
AUTH_JWT_ACCESS_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ISSUER=feca-backend
AUTH_JWT_AUDIENCE=feca-app
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_MAPS_API_KEY=replace-with-google-maps-server-key
GOOGLE_OAUTH_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_PLACES_COUNTRY=uy
GOOGLE_PLACES_LANGUAGE=es
GOOGLE_PLACES_RADIUS_METERS=5000
CACHE_TTL_MS=300000
CACHE_MAX_ITEMS=500
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60
CORS_ALLOWED_ORIGINS=
FECA_ADMIN_EMAILS=
INTERNAL_NOTIFICATIONS_SECRET=replace-with-an-internal-job-secret
TRUST_PROXY=true

# Optional
# EXPO_ACCESS_TOKEN=
# REDIS_URL=
# QUEUE_BACKEND=pg-boss
# SENTRY_DSN=
# GOOGLE_DATA_PORTABILITY_CLIENT_ID=
# GOOGLE_DATA_PORTABILITY_CLIENT_SECRET=
# GOOGLE_DATA_PORTABILITY_REDIRECT_URI=https://api.example.com/v1/google-data-imports/oauth/callback
# GOOGLE_DATA_PORTABILITY_TOKEN_ENCRYPTION_KEY=
