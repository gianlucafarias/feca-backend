{
  "name": "feca-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "check": "tsc --noEmit -p tsconfig.build.json",
    "release:check": "npm run check && npm run test && npm run test:coverage && npm run build && npm audit --omit=dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:up": "docker compose up -d postgres",
    "db:backfill:city-ids": "ts-node src/scripts/backfill-city-ids.ts --write",
    "db:backfill:city-ids:dry": "ts-node src/scripts/backfill-city-ids.ts"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.6.0",
    "cache-manager": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "pg-boss": "^10.4.2",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.1.26",
    "@swc/core": "^1.15.41",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  }
}
