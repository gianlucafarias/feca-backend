NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:test@localhost:5432/feca_test
AUTH_JWT_ACCESS_SECRET=test-jwt-secret-min-16-chars
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_MAPS_API_KEY=test-google-maps-server-key
GOOGLE_OAUTH_WEB_CLIENT_ID=123456789-test.apps.googleusercontent.com
GOOGLE_PLACES_COUNTRY=uy
GOOGLE_PLACES_LANGUAGE=es
GOOGLE_PLACES_RADIUS_METERS=5000
GOOGLE_PLACES_LOCAL_ONLY=false
GOOGLE_PLACE_PHOTOS_HOME_ENABLED=false
GOOGLE_PLACE_PHOTOS_HOME_LIMIT=6
GOOGLE_PLACE_PHOTOS_DETAIL_ENABLED=true
CACHE_TTL_MS=300000
CACHE_MAX_ITEMS=500
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60
TRUST_PROXY=false
INTERNAL_NOTIFICATIONS_SECRET=test-internal-notifications-secret
QUEUE_BACKEND=in-process
