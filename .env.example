NODE_ENV=development
PORT=3001
DATABASE_URL=
AUTH_JWT_ACCESS_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ISSUER=feca-backend
AUTH_JWT_AUDIENCE=feca-app
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_MAPS_API_KEY=replace-with-google-maps-server-key
GOOGLE_OAUTH_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# Google Data Portability is optional. If enabled, configure all four variables.
# GOOGLE_DATA_PORTABILITY_CLIENT_ID=
# GOOGLE_DATA_PORTABILITY_CLIENT_SECRET=
# GOOGLE_DATA_PORTABILITY_REDIRECT_URI=https://api.example.com/v1/google-data-imports/oauth/callback
# GOOGLE_DATA_PORTABILITY_TOKEN_ENCRYPTION_KEY=
GOOGLE_PLACES_COUNTRY=uy
GOOGLE_PLACES_LANGUAGE=es
GOOGLE_PLACES_RADIUS_METERS=5000
CACHE_TTL_MS=300000
CACHE_MAX_ITEMS=500
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_NOTIFICATIONS_SECRET=replace-with-an-internal-job-secret
# Opcional: token de Expo Push para enviar y consultar receipts desde el backend.
# EXPO_ACCESS_TOKEN=
# Opcional: emails separados por coma; el backend puede marcar `isAdmin` en GET /v1/me (p. ej. panel futuro).
# FECA_ADMIN_EMAILS=you@example.com
TRUST_PROXY=false

# Optional: shared cache, distributed rate limits, and single-flight across replicas.
# REDIS_URL=redis://localhost:6379

# Background jobs: in-process (dev/test) or pg-boss (production default).
# QUEUE_BACKEND=in-process
# QUEUE_BACKEND=pg-boss

# Logs estructurados en consola del backend: feed mode=city y places/nearby (userId + coords).
# FECA_DEBUG_CITY=1
